rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff accounts are created in the Firebase console, so any signed-in
    // user is trusted staff. Everything is locked to authenticated users.
    function isStaff() {
      return request.auth != null;
    }

    match /clients/{id}   { allow read, write: if isStaff(); }
    match /quotes/{id}    { allow read, write: if isStaff(); }
    match /invoices/{id}  { allow read, write: if isStaff(); }
    match /meta/{id}      { allow read, write: if isStaff(); }

    // Deny everything else by default.
    match /{document=**}  { allow read, write: if false; }
  }
}
